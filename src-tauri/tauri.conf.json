{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "方舟关系图谱",
  "version": "0.1.0",
  "identifier": "io.github.gar1ton.arknights-relation-atlas",
  "build": { "frontendDist": "../dist-offline" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
